{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图片切图工具",
  "version": "0.1.2",
  "identifier": "com.imageslicing.tools",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "图片切图工具",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQTk5Nzk0NDhCNUYyClJXVHl0VWlVbDZrckFEVTE0R1oxdjhMdVFqMW1DMXAyV2pobFk0MHRWY2E3aUxvOWRtZVdYUnN0Cg==",
      "endpoints": [
        "https://github.com/wenwenwen888/Image_slicing_tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
